# Root env for docker compose. Copy to `.env` and fill in if you have keys.
# Everything is OPTIONAL — the app runs fully without any keys (mock AI + placeholder images).

# AI
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Images
IMAGE_PROVIDER=pexels
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Gemini — used only to caption an attached reference image for the brief
# prompt. Its image generation is unused; artwork comes from the stock-photo
# curator. Kept for future use.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VISION_MODEL=gemini-flash-latest

# OpenRouter — bespoke background art for scribble-originated designs and
# background-edit requests. Optional: without a key, both callers fall
# straight through to the stock-photo curator.
#
# IMAGE_MODEL is text-to-image (FLUX) and takes a prompt only. IMAGE_EDIT_MODEL
# is the one that can be shown a drawing, and it is what makes a Scribble
# generation actually look like what was sketched — it must be a model that
# accepts image input and returns an image.
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
OPENROUTER_IMAGE_EDIT_MODEL=google/gemini-2.5-flash-image
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Content Factory - local transcription (faster-whisper). Runs on the host GPU:
#   powershell -ExecutionPolicy Bypass -File server/whisper/setup.ps1   (one time)
#   npm run whisper:worker --prefix server                              (leave running)
# The backend container reaches the worker through host.docker.internal.
WHISPER_WORKER_URL=http://host.docker.internal:5011
WHISPER_MODEL=large-v3-turbo
WHISPER_LANGUAGE=en
# auto = GPU when CUDA works, otherwise CPU
WHISPER_DEVICE=auto

# Distribution - real publishing to YouTube, a Facebook Page (and, through it,
# Instagram) and TikTok. Every secret is optional and per-platform: without one, that
# platform just can't be connected yet. You must create each developer app yourself
# (Apollo cannot do this for you) - see the README's Distribution section.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Only needed for Instagram: its publish API fetches the rendered video by URL, so it
# must be reachable from the public internet (your own domain, or a tunnel you run
# while publishing) - not localhost. Leave blank and Instagram simply can't publish yet.
PUBLIC_MEDIA_BASE_URL=
# How often Apollo checks the local publish queue and refreshes analytics while it is running.
DISTRIBUTION_TICK_MINUTES=15
