# Root env for docker compose. Copy to `.env` and fill in if you have keys.
# Everything is OPTIONAL — the app runs fully without any keys (mock AI + placeholder images).

# AI
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Images
IMAGE_PROVIDER=pexels
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Gemini — supported but currently unused by the active pipeline (Hugging
# Face is the active image generator below). Kept for future use.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VISION_MODEL=gemini-flash-latest

# Hugging Face — bespoke image generation (FLUX.1 Krea by default), routed
# through whichever Inference Provider Hugging Face has live for the model.
# Optional: without this, generated designs fall back to stock photography.
HUGGINGFACE_API_KEY=
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-Krea-dev
