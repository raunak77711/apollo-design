# Root env for docker compose. Copy to `.env` and fill in if you have keys.
# Everything is OPTIONAL — the app runs fully without any keys (mock AI + placeholder images).

# AI
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Images
IMAGE_PROVIDER=pexels
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
