# Server (local dev). Docker Compose sets its own values — see docker-compose.yml.
PORT=5010
CLIENT_ORIGIN=http://localhost:5180

# MongoDB — if unreachable, the server falls back to an in-memory store.
# Local dev points at the Docker mongo (host port 27020). Change if running mongo elsewhere.
MONGODB_URI=mongodb://127.0.0.1:27020/apollo_design

# AI provider — if DEEPSEEK_API_KEY is missing, a deterministic mock provider is used
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Image providers — if keys are missing, a keyless placeholder provider is used
IMAGE_PROVIDER=pexels
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Gemini — used only to caption an attached reference image for the brief
# prompt. Its image generation is unused; artwork comes from the stock-photo
# curator. Kept for future use.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VISION_MODEL=gemini-flash-latest

# OpenRouter — bespoke background art for scribble-originated designs and
# background-edit requests. Optional: without a key, both callers fall
# straight through to the stock-photo curator.
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
